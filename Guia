<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Guía de uso · Control de Gastos</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
img{max-width:100%}[hidden]{display:none!important}
.back{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:600;text-decoration:none;color:var(--accent)}
/* Layout: guía vertical por pasos; cada paso = explicación + captura real enmarcada, con puntos tocables encima */
:root{
  --bg:#eef2ee; --surface:#ffffff; --ink:#16211c; --muted:#5a6a62; --line:#d6ded8;
  --accent:#1e6a50; --accent-ink:#ffffff; --accent-soft:#d9eadf;
  --warn:#9a6200; --warn-soft:#f6e9cc; --neg:#b0402a; --pos:#1e6a50;
  --shadow:0 1px 2px rgba(22,33,28,.06),0 8px 24px rgba(22,33,28,.07);
  --f-display:"Bricolage Grotesque","Figtree",system-ui,sans-serif;
  --f-body:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-num:"JetBrains Mono",ui-monospace,"SF Mono",Menlo,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#111815; --surface:#18221e; --ink:#e6eee9; --muted:#9cada4; --line:#2a3832;
  --accent:#5fbf95; --accent-ink:#0d1a14; --accent-soft:#1f3a2e;
  --warn:#e3b04f; --warn-soft:#3a2f17; --neg:#ef8a73; --pos:#5fbf95;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.3); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#111815; --surface:#18221e; --ink:#e6eee9; --muted:#9cada4; --line:#2a3832;
  --accent:#5fbf95; --accent-ink:#0d1a14; --accent-soft:#1f3a2e;
  --warn:#e3b04f; --warn-soft:#3a2f17; --neg:#ef8a73; --pos:#5fbf95;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.3); color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.55;margin:0}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
.wrap{max-width:1120px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
h1,h2,h3{font-family:var(--f-display);text-wrap:balance;margin:0;letter-spacing:-.01em}
p{margin:0}
.num{font-family:var(--f-num);font-variant-numeric:tabular-nums}
.eyebrow{font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}
a{color:var(--accent)}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px;border-radius:6px}

/* Hero */
.hero{padding-block:48px 28px;display:grid;gap:28px}
.hero h1{font-size:clamp(34px,6vw,60px);font-weight:800;line-height:1.02}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero .lead{max-width:62ch;font-size:18px;color:var(--muted)}
.flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;counter-reset:f}
.flow li{list-style:none;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px;display:grid;gap:4px;position:relative}
.flow li b{font-size:15px}
.flow li span{font-size:13.5px;color:var(--muted)}
.flow li .who{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.flow li.tu{border-color:var(--accent);background:var(--accent-soft)}
.flow li.tu .who{color:var(--accent)}
.flow li:not(:last-child)::after{content:"→";position:absolute;right:-9px;top:50%;transform:translateY(-50%);color:var(--muted);font-weight:700;background:var(--bg);line-height:1;padding:2px 0}
.flowwrap{margin:0;padding:0}
.note-ej{font-size:13px;color:var(--muted);display:flex;gap:8px;align-items:flex-start}
.note-ej i{font-style:normal;background:var(--warn-soft);color:var(--warn);border-radius:999px;padding:1px 8px;font-weight:700;font-size:11px;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}

/* Navegación de pasos */
.rail{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(6px);border-bottom:1px solid var(--line)}
.rail .wrap{display:flex;gap:6px;overflow-x:auto;padding-block:10px;scrollbar-width:none}
.rail a{flex:none;text-decoration:none;color:var(--ink);font-size:13.5px;font-weight:600;padding:6px 12px;border-radius:999px;border:1px solid var(--line);background:var(--surface);display:flex;gap:6px;align-items:center}
.rail a span{font-family:var(--f-num);font-size:12px;color:var(--muted)}
.rail a.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.rail a.on span{color:var(--bg);opacity:.7}

/* Pasos */
main{display:grid;gap:18px;padding-block:28px 64px}
.step{display:grid;grid-template-columns:minmax(0,360px) minmax(0,1fr);gap:28px;align-items:start;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:28px;scroll-margin-top:70px}
.step.wide{grid-template-columns:1fr}
.step .txt{display:grid;gap:12px;min-width:0}
.step .n{font-family:var(--f-num);font-size:13px;color:var(--accent);font-weight:600}
.step h2{font-size:clamp(24px,3vw,30px);font-weight:800;line-height:1.1}
.step p{color:var(--muted);max-width:60ch}
.step ul{margin:0;padding-left:18px;color:var(--muted);display:grid;gap:4px}
.step li b,.step p b{color:var(--ink);font-weight:600}
.tip{background:var(--accent-soft);border-radius:10px;padding:10px 12px;font-size:14px;color:var(--ink)}
.tip.warn{background:var(--warn-soft)}
.tip strong{display:block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:2px}
.tip.warn strong{color:var(--warn)}

/* Marco de captura */
.shot{margin:0;display:grid;gap:8px;min-width:0}
.frame{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff;box-shadow:var(--shadow);position:relative}
.frame .bar{height:26px;background:#eef1ee;border-bottom:1px solid #dfe5e0;display:flex;align-items:center;gap:6px;padding:0 10px}
.frame .bar i{width:9px;height:9px;border-radius:50%;background:#d0d7d2;display:block}
.frame .bar em{font-style:normal;font-size:11px;color:#6b7a72;margin-left:8px;font-family:var(--f-num)}
.frame .pic{position:relative;display:block;width:100%;cursor:zoom-in;padding:0;border:0;background:none}
.frame img{display:block;width:100%;height:auto}
.phone{max-width:300px;border-radius:30px;border:8px solid #1d2622;box-shadow:var(--shadow);overflow:hidden;background:#fff;justify-self:center}
.phone img{display:block;width:100%;height:auto}
figcaption{font-size:13px;color:var(--muted)}

/* Puntos tocables */
.pin{position:absolute;transform:translate(-50%,-50%);width:28px;height:28px;border-radius:50%;border:2px solid #fff;background:var(--accent);color:var(--accent-ink);font:600 13px/1 var(--f-num);display:grid;place-items:center;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.25);z-index:2;padding:0}
:root:not([data-theme]) .pin,:root .pin{background:#1e6a50;color:#fff}
.pin::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:2px solid #1e6a50;opacity:.55;animation:pulse 2.2s ease-out infinite}
.pin.on{background:#16211c}
.pin.on::after{animation:none;opacity:0}
@keyframes pulse{0%{transform:scale(.8);opacity:.6}100%{transform:scale(1.5);opacity:0}}
@media (prefers-reduced-motion:reduce){.pin::after{animation:none}}
.keys{display:grid;gap:6px;counter-reset:k;margin:0;padding:0}
.keys li{list-style:none;display:grid;grid-template-columns:28px 1fr;gap:10px;align-items:start;padding:8px 10px;border-radius:10px;cursor:pointer;border:1px solid transparent;color:var(--muted);font-size:14.5px}
.keys li b{color:var(--ink)}
.keys li .k{width:24px;height:24px;border-radius:50%;background:var(--accent-soft);color:var(--accent);font:600 12px/24px var(--f-num);text-align:center}
.keys li.on{border-color:var(--accent);background:var(--accent-soft)}
.keys li.on .k{background:var(--accent);color:var(--accent-ink)}

/* Calculadora de saldo */
.calc{display:grid;gap:8px}
.calc label{display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:10px;align-items:center;font-size:14px;font-weight:600;color:var(--muted)}
.calc input{font:600 17px var(--f-num);padding:10px 12px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--ink);width:100%;text-align:right}
.eq{display:grid;gap:8px;background:var(--bg);border-radius:12px;padding:16px;margin-top:4px}
.eq .row{display:flex;justify-content:space-between;gap:12px;font-size:14.5px;flex-wrap:wrap}
.eq .row span:first-child{color:var(--muted)}
.eq .tot{border-top:2px solid var(--ink);padding-top:8px;font-weight:700;font-size:16px}
.neg{color:var(--neg)} .pos{color:var(--pos)}
.verdict{font-family:var(--f-display);font-weight:800;font-size:22px}

/* Glosario */
.gl{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
.gl div{border:1px solid var(--line);border-radius:12px;padding:12px 14px;display:grid;gap:6px;background:var(--bg)}
.gl p{font-size:14px}
.chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:2px 10px;font-size:12px;font-weight:700;width:max-content}
.c-app{background:var(--accent-soft);color:var(--accent)}
.c-man{background:color-mix(in srgb,var(--muted) 18%,transparent);color:var(--ink)}
.c-val{background:var(--warn-soft);color:var(--warn)}
.c-tipo{background:var(--surface);border:1px solid var(--line);color:var(--ink);font-family:var(--f-num);font-weight:600}

/* Visor ampliado */
dialog{border:0;padding:0;background:transparent;max-width:min(96vw,1500px);max-height:94vh}
dialog::backdrop{background:rgba(10,15,12,.82)}
dialog img{display:block;max-width:100%;max-height:88vh;border-radius:10px}
dialog button{position:absolute;top:8px;right:8px;border:0;border-radius:999px;background:#fff;color:#16211c;font:600 13px var(--f-body);padding:6px 12px;cursor:pointer}

footer{padding-block:0 48px;color:var(--muted);font-size:13px}

@media (max-width:860px){
  .step{grid-template-columns:1fr;padding:20px}
  .flow{grid-template-columns:repeat(2,minmax(0,1fr))}
  .flow li:nth-child(2)::after{display:none}
  .calc{grid-template-columns:1fr}
}
@media (max-width:420px){.flow{grid-template-columns:1fr}.flow li::after{display:none}.pin{width:22px;height:22px;font-size:11px}}
</style>
</head>
<body>


<header class="wrap hero">
  <a class="back" href="./">← Volver a Control de Gastos</a>
  <div class="eyebrow">Control de Gastos · Guía de uso</div>
  <h1>Hola, Elba. Así ves y registras <em>los gastos de la familia</em>.</h1>
  <p class="lead">Jonathan anota todo en su app del iPhone y lo reparte en la plataforma. Tú entras con tu usuario, ves cuánto te toca cada mes, registras lo que pagaste o abonaste y descargas tu reporte.</p>
  <ol class="flow flowwrap" aria-label="Cómo viaja la información">
    <li><span class="who">Jonathan</span><b>Anota en Registro Contable</b><span>Cada gasto queda en la app del iPhone.</span></li>
    <li><span class="who">Jonathan</span><b>Sincroniza y reparte</b><span>Decide si es compartido o de una persona.</span></li>
    <li class="tu"><span class="who">Tú</span><b>Revisas y registras</b><span>Ves tu saldo y agregas lo que pagaste.</span></li>
    <li><span class="who">Jonathan</span><b>Valida</b><span>Lo que registras cuenta cuando él lo aprueba.</span></li>
  </ol>
  <p class="note-ej"><i>Ejemplo</i><span>Las capturas son de la plataforma vista con el usuario de Elba, con montos de ejemplo de septiembre 2026. Tus cifras reales las ves al entrar.</span></p>
</header>

<nav class="rail" aria-label="Pasos de la guía"><div class="wrap" id="rail">
  <a href="#entrar"><span>1</span>Entrar</a>
  <a href="#inicio"><span>2</span>Inicio</a>
  <a href="#familia"><span>3</span>Familia</a>
  <a href="#saldo"><span>4</span>Tu saldo</a>
  <a href="#detalle"><span>5</span>Ver un gasto</a>
  <a href="#registrar"><span>6</span>Registrar un gasto</a>
  <a href="#abonar"><span>7</span>Registrar un abono</a>
  <a href="#reporte"><span>8</span>Reporte</a>
  <a href="#celular"><span>9</span>En el celular</a>
  <a href="#glosario"><span>?</span>Qué significa</a>
</div></nav>

<main class="wrap">

<section class="step" id="entrar">
  <div class="txt">
    <div class="n">Paso 1</div>
    <h2>Entra con tu correo</h2>
    <p>Abre <b>jcanales1097.github.io</b> desde Safari, en la computadora o el celular. Escribe tu correo y tu contraseña y toca <b>Entrar</b>.</p>
    <div class="tip"><strong>¿Se te olvidó?</strong>Toca “Olvidé mi contraseña” y te llega un correo para crear una nueva.</div>
  </div>
  <figure class="shot">
    <div class="frame"><div class="bar"><i></i><i></i><i></i><em>jcanales1097.github.io</em></div><button class="pic" data-zoom="login" aria-label="Ampliar captura de la pantalla de entrada"><img alt="Pantalla de entrada con correo y contraseña" data-img="login"></button></div>
  </figure>
</section>

<section class="step" id="inicio">
  <div class="txt">
    <div class="n">Paso 2</div>
    <h2>En Inicio ves tu saldo del mes</h2>
    <p>Aparece una tarjeta por cada control que compartes. En <b>Gastos Familiares</b> ves lo gastado en el mes y <b>tu saldo</b>.</p>
    <ul><li><b class="pos">Verde</b>: estás al día o tienes a favor.</li><li><b class="neg">Rojo</b>: te falta aportar esa cantidad.</li></ul>
    <p>Toca la tarjeta para abrir el detalle.</p>
  </div>
  <figure class="shot">
    <div class="frame"><div class="bar"><i></i><i></i><i></i><em>Inicio</em></div><button class="pic" data-zoom="inicio" aria-label="Ampliar captura de Inicio"><img alt="Inicio con la tarjeta de Gastos Familiares y Tu saldo" data-img="inicio"></button></div>
  </figure>
</section>

<section class="step wide" id="familia">
  <div class="txt">
    <div class="n">Paso 3</div>
    <h2>La pantalla de Familia, punto por punto</h2>
    <p>Toca los números verdes sobre la captura o en la lista para saber qué es cada parte.</p>
  </div>
  <div class="step-in" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,300px);gap:20px;align-items:start" data-hot="fam">
    <figure class="shot">
      <div class="frame"><div class="bar"><i></i><i></i><i></i><em>Familia · Septiembre 2026</em></div>
        <div class="pic" style="cursor:default"><img alt="Pantalla del control Familia con selector de mes, totales y distribución" data-img="familia">
          <button class="pin" style="left:10.5%;top:18%" data-k="1" aria-label="Punto 1">1</button>
          <button class="pin" style="left:22%;top:25.5%" data-k="2" aria-label="Punto 2">2</button>
          <button class="pin" style="left:84%;top:9.5%" data-k="3" aria-label="Punto 3">3</button>
          <button class="pin" style="left:55%;top:39%" data-k="4" aria-label="Punto 4">4</button>
          <button class="pin" style="left:12%;top:51%" data-k="5" aria-label="Punto 5">5</button>
          <button class="pin" style="left:62%;top:78%" data-k="6" aria-label="Punto 6">6</button>
          <button class="pin" style="left:90%;top:51.5%" data-k="7" aria-label="Punto 7">7</button>
        </div></div>
    </figure>
    <ol class="keys">
      <li data-k="1"><span class="k">1</span><span><b>Mes.</b> Cambia de mes con las flechas o las listas. El punto • marca los meses con movimientos.</span></li>
      <li data-k="2"><span class="k">2</span><span><b>Quiénes participan</b> ese mes. Lo compartido se divide entre ellos.</span></li>
      <li data-k="3"><span class="k">3</span><span><b>Reporte PDF y Excel</b> para descargar el mes.</span></li>
      <li data-k="4"><span class="k">4</span><span><b>Totales del mes:</b> ingresos, egresos, saldo y lo que está por validar.</span></li>
      <li data-k="5"><span class="k">5</span><span><b>Resumen:</b> cuánto fue compartido y cuánto fue de cada persona.</span></li>
      <li data-k="6"><span class="k">6</span><span><b>Tu fila:</b> total a pagar, lo que abonaste y tu saldo.</span></li>
      <li data-k="7"><span class="k">7</span><span><b>Ver saldos anteriores:</b> muestra cómo cerraste el mes pasado y tu saldo acumulado.</span></li>
    </ol>
  </div>
</section>

<section class="step" id="saldo">
  <div class="txt">
    <div class="n">Paso 4</div>
    <h2>Cómo se calcula tu saldo</h2>
    <p>Lo <b>compartido</b> se divide en partes iguales. A tu parte se suma lo que se marcó como <b>tuyo</b> (por ejemplo, una compra solo para ti). Luego se resta lo que ya <b>abonaste</b>.</p>
    <p>Cambia los números para probar. Vienen con el ejemplo de la captura.</p>
    <div class="calc" role="group" aria-label="Calculadora de saldo">
      <label for="cComp">Compartido del mes<input id="cComp" inputmode="decimal" value="8,442.13"></label>
      <label for="cTuyo">Gastos solo tuyos<input id="cTuyo" inputmode="decimal" value="1,500.68"></label>
      <label for="cAbono">Lo que abonaste<input id="cAbono" inputmode="decimal" value="8,500.00"></label>
    </div>
    <div class="eq" aria-live="polite">
      <div class="row"><span>Tu mitad de lo compartido (÷ 2)</span><span class="num" id="rMitad"></span></div>
      <div class="row"><span>+ Gastos solo tuyos</span><span class="num" id="rTuyo"></span></div>
      <div class="row"><span>= Total a pagar</span><span class="num" id="rPagar"></span></div>
      <div class="row"><span>− Lo que abonaste</span><span class="num" id="rAbono"></span></div>
      <div class="row tot"><span>Saldo</span><span class="num" id="rSaldo"></span></div>
      <div class="verdict" id="rVer"></div>
    </div>
  </div>
  <figure class="shot">
    <div class="frame"><div class="bar"><i></i><i></i><i></i><em>Distribución por persona</em></div><button class="pic" data-zoom="saldos" aria-label="Ampliar captura de saldos"><img alt="Distribución por persona con saldo del mes anterior y saldo global" data-img="saldos"></button></div>
    <figcaption>Con “Ver saldos anteriores” aparecen el saldo del mes pasado y el <b>saldo global</b> (todos los meses sumados). Son solo referencia: no cambian el mes actual.</figcaption>
  </figure>
</section>

<section class="step" id="detalle">
  <div class="txt">
    <div class="n">Paso 5</div>
    <h2>Toca un gasto para ver todo</h2>
    <p>En la tabla de egresos puedes buscar, filtrar por subcategoría o cuenta y ordenar tocando los encabezados.</p>
    <p>Al tocar la descripción se abre la ficha del gasto: fecha, categoría, cómo quedó en la app de Jonathan y los <b>comprobantes</b> adjuntos (factura, transferencia).</p>
    <div class="tip"><strong>Comprobantes</strong>Si pagaste algo, adjunta la foto o el PDF desde “Adjuntar comprobante” en la ficha de tu registro.</div>
  </div>
  <figure class="shot">
    <div class="frame"><div class="bar"><i></i><i></i><i></i><em>Ficha del gasto</em></div><button class="pic" data-zoom="detalle" aria-label="Ampliar ficha del gasto"><img alt="Ficha con los datos completos de un gasto" data-img="detalle"></button></div>
  </figure>
</section>

<section class="step wide" id="registrar">
  <div class="txt">
    <div class="n">Paso 6</div>
    <h2>Registra un gasto que pagaste tú</h2>
    <ul>
      <li>Baja hasta el final de <b>Detalle egreso</b>. La última fila está lista para escribir.</li>
      <li>Elige la <b>fecha</b> y el <b>tipo</b>: <b>COMPARTIDO</b> si es para la casa, <b>ELBA KATTAN</b> si es solo tuyo.</li>
      <li>Escribe <b>dónde y qué</b> (ej.: “FARMACIA KIELSA | Vitaminas”) y el <b>valor</b>. Toca <b>Registrar</b>.</li>
    </ul>
  </div>
  <figure class="shot">
    <div class="frame"><div class="bar"><i></i><i></i><i></i><em>Detalle egreso · fila para registrar</em></div><button class="pic" data-zoom="registrar" aria-label="Ampliar fila para registrar"><img alt="Fila al final de la tabla con un gasto escrito" data-img="registrar"></button></div>
  </figure>
  <div class="step-in" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,300px);gap:20px;align-items:start" data-hot="val">
    <figure class="shot">
      <div class="frame"><div class="bar"><i></i><i></i><i></i><em>Después de registrar</em></div>
        <div class="pic" style="cursor:default"><img alt="El gasto aparece resaltado con la etiqueta Por validar" data-img="porvalidar">
          <button class="pin" style="left:75%;top:26%" data-k="1" aria-label="Punto 1">1</button>
          <button class="pin" style="left:86.5%;top:94.5%" data-k="2" aria-label="Punto 2">2</button>
          <button class="pin" style="left:95%;top:94.5%" data-k="3" aria-label="Punto 3">3</button>
        </div></div>
    </figure>
    <ol class="keys">
      <li data-k="1"><span class="k">1</span><span><b>Por validar</b> sube a 1. Tu registro todavía no cuenta en los totales.</span></li>
      <li data-k="2"><span class="k">2</span><span>Tu fila queda <b>resaltada</b> con la etiqueta “Por validar” hasta que Jonathan la revise.</span></li>
      <li data-k="3"><span class="k">3</span><span>Mientras no esté validada puedes <b>corregirla o borrarla</b>.</span></li>
    </ol>
  </div>
</section>

<section class="step wide" id="abonar">
  <div class="txt">
    <div class="n">Paso 7</div>
    <h2>Registra tus abonos</h2>
    <p>Cuando le transfieras a Jonathan para los gastos de la casa, regístralo en <b>Detalle ingreso</b>, al final de la página. Tu nombre ya viene seleccionado. Escribe de dónde viene (ej.: “Transferencia BAC | Abono octubre”) y el valor, y toca <b>Registrar</b>. Al validarse, aparece en la columna <b>Abonado</b> y baja tu saldo pendiente.</p>
  </div>
  <figure class="shot">
    <div class="frame"><div class="bar"><i></i><i></i><i></i><em>Detalle ingreso</em></div><button class="pic" data-zoom="abono" aria-label="Ampliar fila de abono"><img alt="Tabla de ingresos con un abono escrito en la última fila" data-img="abono"></button></div>
  </figure>
</section>

<section class="step" id="reporte">
  <div class="txt">
    <div class="n">Paso 8</div>
    <h2>Descarga tu reporte del mes</h2>
    <p>Toca <b>Reporte PDF</b>. Puedes bajar el reporte completo o <b>solo el tuyo</b>: “ELBA KATTAN · sus gastos y los compartidos”. Sirve para revisar o guardar cada cierre de mes.</p>
    <p><b>Exportar a Excel</b> baja la hoja del mes para hacer tus propias cuentas.</p>
  </div>
  <figure class="shot">
    <div class="frame"><div class="bar"><i></i><i></i><i></i><em>Reporte PDF</em></div><button class="pic" data-zoom="pdf" aria-label="Ampliar menú de reporte"><img alt="Menú de Reporte PDF con la opción de reporte por persona" data-img="pdf"></button></div>
  </figure>
</section>

<section class="step" id="celular">
  <div class="txt">
    <div class="n">Paso 9</div>
    <h2>Igual desde el celular</h2>
    <p>La plataforma se acomoda a la pantalla del teléfono. Todo lo de esta guía funciona igual: revisar tu saldo, registrar un gasto o un abono y bajar tu reporte.</p>
    <div class="tip"><strong>Atajo</strong>En Safari toca Compartir → “Agregar a pantalla de inicio” para tenerla como una app más.</div>
  </div>
  <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-items:start">
    <button class="phone pic" data-zoom="movil" aria-label="Ampliar Inicio en el celular"><img alt="Inicio en el celular" data-img="movil"></button>
    <button class="phone pic" data-zoom="movilfam" aria-label="Ampliar Familia en el celular"><img alt="Familia en el celular" data-img="movilfam"></button>
  </div>
</section>

<section class="step wide" id="glosario">
  <div class="txt">
    <div class="n">Glosario</div>
    <h2>Qué significa cada etiqueta</h2>
  </div>
  <div class="gl">
    <div><span class="chip c-tipo">COMPARTIDO</span><p>Gasto de la casa. Se divide en partes iguales entre quienes participan ese mes.</p></div>
    <div><span class="chip c-tipo">ELBA KATTAN</span><p>Gasto solo tuyo. Se suma completo a tu total a pagar.</p></div>
    <div><span class="chip c-app">App</span><p>Viene de la app de Jonathan, ya revisado.</p></div>
    <div><span class="chip c-man">Manual</span><p>Lo escribió alguien en la plataforma y ya está validado.</p></div>
    <div><span class="chip c-val">Por validar</span><p>Lo registraste tú y espera la revisión de Jonathan. Aún no cuenta.</p></div>
    <div><span class="chip c-tipo"><span class="neg">−L 1,250.00</span></span><p>Saldo en rojo: te falta aportar. En verde: estás al día o tienes a favor.</p></div>
  </div>
</section>

</main>
<footer class="wrap">Guía preparada para Elba Kattan · Control de Gastos · noviembre 2026</footer>

<dialog id="zoom" aria-label="Captura ampliada"><button type="button" id="zClose">Cerrar</button><img id="zImg" alt=""></dialog>

<script>
const IMGS = {"login": {"src": "data:image/jpeg;base64,", "w": 640, "h": 490}, "inicio": {"src": "data:image/jpeg;base64,", "w": 900, "h": 320}, "familia": {"src": "data:image/jpeg;base64,", "w": 1440, "h": 530}, "saldos": {"src": "data:image/jpeg;base64,", "w": 680, "h": 417}, "detalle": {"src": "data:image/jpeg;base64,", "w": 660, "h": 1000}, "registrar": {"src": "data:image/jpeg;base64,", "w": 1440, "h": 210}, "porvalidar": {"src": "data:image/jpeg;base64,", "w": 1440, "h": 800}, "abono": {"src": "data:image/jpeg;base64,", "w": 1440, "h": 240}, "pdf": {"src": "data:image/jpeg;base64,", "w": 490, "h": 270}, "movil": {"src": "data:image/jpeg;base64,", "w": 390, "h": 560}, "movilfam": {"src": "data:image/jpeg;base64,", "w": 390, "h": 844}};
document.querySelectorAll('img[data-img]').forEach(im => { const d = IMGS[im.dataset.img]; if (d) { im.src = d.src; im.width = d.w; im.height = d.h; } });
const dlg = document.getElementById('zoom'), zi = document.getElementById('zImg');
document.querySelectorAll('[data-zoom]').forEach(b => b.addEventListener('click', () => { const d = IMGS[b.dataset.zoom]; zi.src = d.src; zi.alt = (b.querySelector('img') || {}).alt || ''; try { dlg.showModal(); } catch (e) { dlg.setAttribute('open', ''); } }));
document.getElementById('zClose').addEventListener('click', () => dlg.close());
dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
document.querySelectorAll('[data-hot]').forEach(g => {
  const sel = k => { g.querySelectorAll('[data-k]').forEach(x => x.classList.toggle('on', x.dataset.k === k)); };
  g.querySelectorAll('[data-k]').forEach(x => x.addEventListener('click', () => sel(x.dataset.k)));
  g.querySelectorAll('.keys li').forEach(x => { x.tabIndex = 0; x.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); sel(x.dataset.k); } }); });
  sel('1');
});
const fmt = v => (v < 0 ? '−' : '') + 'L ' + Math.abs(v).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
const val = id => { const x = parseFloat(String(document.getElementById(id).value).replace(/[^0-9.\-]/g, '')); return isFinite(x) ? x : 0; };
const r2 = x => Math.sign(x) * Math.round(Math.abs(x) * 100 + 1e-6) / 100;
function calc() {
  const mitad = r2(val('cComp') / 2), tuyo = val('cTuyo'), pagar = r2(val('cComp') / 2 + tuyo), ab = val('cAbono'), saldo = r2(ab - pagar);
  document.getElementById('rMitad').textContent = fmt(mitad);
  document.getElementById('rTuyo').textContent = fmt(tuyo);
  document.getElementById('rPagar').textContent = fmt(pagar);
  document.getElementById('rAbono').textContent = fmt(ab);
  const s = document.getElementById('rSaldo'); s.textContent = fmt(saldo); s.className = 'num ' + (saldo < -0.004 ? 'neg' : 'pos');
  const v = document.getElementById('rVer'); v.className = 'verdict ' + (saldo < -0.004 ? 'neg' : 'pos');
  v.textContent = saldo < -0.004 ? 'Te falta aportar ' + fmt(-saldo) : saldo > 0.004 ? 'Tienes ' + fmt(saldo) + ' a favor' : 'Estás al día';
}
['cComp', 'cTuyo', 'cAbono'].forEach(id => document.getElementById(id).addEventListener('input', calc)); calc();
const links = [...document.querySelectorAll('#rail a')];
const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { links.forEach(a => a.classList.toggle('on', a.getAttribute('href') === '#' + e.target.id)); const on = links.find(a => a.classList.contains('on')); if (on) { const r = document.getElementById('rail'); r.scrollTo({left: on.offsetLeft - 16, behavior: 'smooth'}); } } }), {rootMargin: '-40% 0px -55% 0px'});
document.querySelectorAll('section.step').forEach(s => io.observe(s));
</script>

